# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Active AI Provider: "gemini" | "bedrock" | "agnes"
AI_PROVIDER=gemini

# Agnes AI Configuration (OpenAI-compatible dev/testing gateway)
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_ID=agnes-2.5-flash

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_ID=gemini-2.5-flash

# AWS Serverless Configuration ($20 Sandbox Cap - Pay-per-use Bedrock & S3 ONLY)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
AWS_S3_BUCKET=merchant-ai-copilot-td26-076

# Synthetic Demo VietQR Configuration (Strictly fictional merchant account)
NEXT_PUBLIC_VIETQR_BANK_ID=MB
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=0123456789
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=TIEM CA PHE MOC
